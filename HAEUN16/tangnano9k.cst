// ============================================================================
// tangnano9k.cst - Tang Nano 9K (GW1NR-LV9QN88PC6/I5) 핀 제약
// ============================================================================
// top_tangnano9k 포트와 연결
// Gowin IDE: Project -> Add constraint file
// Place&Route: "Use DONE as regular IO" 체크 권장 (Sipeed Wiki)
// ============================================================================

// 시스템 클럭 27MHz (3.3V bank)
IO_LOC "sys_clk" 52;
IO_PORT "sys_clk" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// 사용자 버튼 S1 (1.8V, active-low, 누르면 리셋)
IO_LOC "sys_rst_n" 4;
IO_PORT "sys_rst_n" PULL_MODE=UP BANK_VCCIO=1.8;

// LED 6개 (1.8V, active-low: 0=켜짐)
IO_LOC "led[0]" 10;
IO_PORT "led[0]" PULL_MODE=UP DRIVE=8 BANK_VCCIO=1.8;
IO_LOC "led[1]" 11;
IO_PORT "led[1]" PULL_MODE=UP DRIVE=8 BANK_VCCIO=1.8;
IO_LOC "led[2]" 13;
IO_PORT "led[2]" PULL_MODE=UP DRIVE=8 BANK_VCCIO=1.8;
IO_LOC "led[3]" 14;
IO_PORT "led[3]" PULL_MODE=UP DRIVE=8 BANK_VCCIO=1.8;
IO_LOC "led[4]" 15;
IO_PORT "led[4]" PULL_MODE=UP DRIVE=8 BANK_VCCIO=1.8;
IO_LOC "led[5]" 16;
IO_PORT "led[5]" PULL_MODE=UP DRIVE=8 BANK_VCCIO=1.8;

// UART TX (3.3V, 115200 8N1) — USB-UART 브리지 또는 FTDI RX에 연결
IO_LOC "uart_tx" 17;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
